# ---------------------------------------------------------------------------
# Node / Nuxt / Electron (client)
# ---------------------------------------------------------------------------
node_modules/
client/node_modules/
.nuxt/
client/.nuxt/
.output/
client/.output/
dist/
client/dist/
# `nuxt generate` creates client/dist as a symlink to .output/public; the
# trailing-slash patterns above only match directories, so ignore it without
# the slash too.
client/dist
dist-electron/
client/dist-electron/
.env
.DS_Store
*.log
*.local
.vscode/*
!.vscode/extensions.json
.idea
# Lockfiles are committed so CI builds are reproducible, but this fork uses
# pnpm: pnpm-lock.yaml at the repo root is the single lockfile for every
# workspace package (client, docs-site). npm lockfiles are ignored everywhere
# so a stray `npm install` can't commit a second, conflicting dependency graph.
package-lock.json
build/
!client/build/
out/
yt-dlp.exe
.claude

# ---------------------------------------------------------------------------
# Server (C++ / CMake / vcpkg)
# ---------------------------------------------------------------------------
server/build/
server/build-*/
server/out/
server/cmake-build-*/
server/vcpkg_installed/
server/.vcpkg-root
server/CMakeCache.txt
server/CMakeFiles/
server/compile_commands.json
server/.vs/
